# ----- MelodyForge / CodeAlpha Music Generation Tool -----
# No API keys required — runs fully locally with Magenta + TensorFlow.
# Use this file as a template: copy to `.env` if you want to override defaults.

# Path to a Magenta MelodyRNN bundle (.mag). Auto-detected if not set.
# BUNDLE_PATH=bundles/attention_rnn.mag

# Streamlit theme (optional)
# STREAMLIT_THEME_BASE=dark
# STREAMLIT_THEME_PRIMARY_COLOR=#E040FB

# TensorFlow verbosity: 3 = errors only, 1 = everything (default)
# TF_CPP_MIN_LOG_LEVEL=3
